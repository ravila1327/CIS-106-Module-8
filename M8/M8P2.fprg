<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="M8P2"/>
        <attribute name="authors" value="rafae"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-16 07:23:21 PM"/>
        <attribute name="created" value="cmFmYWU7UkFGQTsyMDI2LTExLTE2OzA2OjU2OjU0IFBNOzIwODI="/>
        <attribute name="edited" value="cmFmYWU7UkFGQTsyMDI2LTExLTE2OzA3OjIzOjIxIFBNOzE7MjE3OQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="first" type="Integer" array="False" size=""/>
            <declare name="second" type="Integer" array="False" size=""/>
            <declare name="nextNumber" type="Integer" array="False" size=""/>
            <declare name="count" type="Integer" array="False" size=""/>
            <assign variable="first" expression="0"/>
            <assign variable="second" expression="1"/>
            <for variable="count" start="1" end="20" direction="inc" step="1">
                <output expression="second" newline="True"/>
                <assign variable="nextNumber" expression="first + second"/>
                <assign variable="first" expression="second"/>
                <assign variable="second" expression="nextNumber"/>
            </for>
        </body>
    </function>
</flowgorithm>
